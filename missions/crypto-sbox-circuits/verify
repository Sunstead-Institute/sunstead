        "score_const": "CryptoSbox.camelliaTotalScore",
        "statement": "def camellia_total_gates (n : Nat) : Prop := CryptoSbox.ValidTotalCircuit CryptoSbox.camelliaSbox1 n",
        "label": "{score} total gates",
    },
    "camellia_and_gates": {
        "module": "CryptoSbox.CamelliaAndBound",
