/-! ## Exact Reference S-box Definitions (Matching Verbatim Upstream C) -/

/-- SKINNY-128 8-bit S-box (`internal-skinnyutil.h`: `skinny128_sbox`). -/
def skinny8Sbox (x : BitVec 8) : BitVec 8 :=
  let x := ~~~x
  let x := x ^^^ (((x >>> 2) &&& (x >>> 3)) &&& 0x11#8)
  let y := ((x <<< 5) &&& (x <<< 1)) &&& 0x20#8
  let x := x ^^^ (((x <<< 5) &&& (x <<< 4)) &&& 0x40#8) ^^^ y
  let y := ((x <<< 2) &&& (x <<< 1)) &&& 0x80#8
  let x := x ^^^ (((x >>> 2) &&& (x <<< 1)) &&& 0x02#8) ^^^ y
  let y := ((x >>> 5) &&& (x <<< 1)) &&& 0x04#8
  let x := x ^^^ (((x >>> 1) &&& (x >>> 2)) &&& 0x08#8) ^^^ y
  let x := ~~~x
  ((x &&& 0x08#8) <<< 1) ||| ((x &&& 0x32#8) <<< 2) ||| ((x &&& 0x01#8) <<< 5) |||
    ((x &&& 0x80#8) >>> 6) ||| ((x &&& 0x40#8) >>> 4) ||| ((x &&& 0x04#8) >>> 2)

/-- Ascon 5-bit S-box (NIST SP 800-232, `internal-ascon.c`; `x0` = MSB bit 4, `x4` = LSB bit 0). -/
def asconSbox (v : BitVec 5) : BitVec 5 :=
  let x0 := v.getLsbD 4; let x1 := v.getLsbD 3; let x2 := v.getLsbD 2
  let x3 := v.getLsbD 1; let x4 := v.getLsbD 0
  let x0 := xor x0 x4; let x4 := xor x4 x3; let x2 := xor x2 x1
  let t0 := (!x0) && x1; let t1 := (!x1) && x2; let t2 := (!x2) && x3
  let t3 := (!x3) && x4; let t4 := (!x4) && x0
  let x0 := xor x0 t1; let x1 := xor x1 t2; let x2 := xor x2 t3
  let x3 := xor x3 t4; let x4 := xor x4 t0
  let x1 := xor x1 x0; let x0 := xor x0 x4; let x3 := xor x3 x2; let x2 := !x2
  packBits 5 (fun i => match i with | 0 => x4 | 1 => x3 | 2 => x2 | 3 => x1 | _ => x0)

/-- Keccak-χ 5-bit S-box (NIST FIPS 202, `internal-keccak.c`). -/
def keccakChiSbox (v : BitVec 5) : BitVec 5 :=
  packBits 5 (fun i => xor (v.getLsbD i) ((!(v.getLsbD ((i + 1) % 5))) && v.getLsbD ((i + 2) % 5)))

/-- PRESENT / PHOTON-256 4-bit S-box (ISO/IEC 29192-2, `internal-photon256.c`). -/
def presentSbox (v : BitVec 4) : BitVec 4 :=
  let x0 := v.getLsbD 0; let x1 := v.getLsbD 1; let x2 := v.getLsbD 2; let x3 := v.getLsbD 3
  let x1 := xor x1 x2
  let x3 := xor x3 (x2 && x1)
  let t1 := x3
  let x3 := xor (x3 && x1) x2
  let t2 := x3
  let x3 := !(xor x3 x0)
  let x2 := x3
  let t2 := t2 || x0
  let x0 := xor x0 t1
  let x1 := xor x1 x0
  let x2 := xor (x2 || x1) t1
  let x1 := xor x1 t2
  let x3 := xor x3 x1
  packBits 4 (fun i => match i with | 0 => x0 | 1 => x1 | 2 => x2 | _ => x3)

/-- GIFT-128 4-bit S-box (`internal-gift128.c`: `gift128b_sbox` with final `s0 ↔ s3` swap). -/
def giftSbox (v : BitVec 4) : BitVec 4 :=
  let s0 := v.getLsbD 0; let s1 := v.getLsbD 1; let s2 := v.getLsbD 2; let s3 := v.getLsbD 3
  let s1 := xor s1 (s0 && s2)
  let s0 := xor s0 (s1 && s3)
  let s2 := xor s2 (s0 || s1)
  let s3 := xor s3 s2
  let s1 := xor s1 s3
  let s3 := !s3
  let s2 := xor s2 (s0 && s1)
  packBits 4 (fun i => match i with | 0 => s3 | 1 => s1 | 2 => s2 | _ => s0)

/-- Spongent / Elephant 4-bit S-box (`internal-spongent.c`). -/
def spongentSbox (v : BitVec 4) : BitVec 4 :=
  let x3 := v.getLsbD 0; let x2 := v.getLsbD 1; let x1 := v.getLsbD 2; let x0 := v.getLsbD 3
  let q0 := xor x0 x2; let q1 := xor x1 x2
  let t0 := q0 && q1
  let q2 := !(xor (xor (xor x0 x1) x3) t0)
  let t1 := q2 && (!x0)
  let q3 := xor x1 t1
  let t2 := q3 && (xor (xor (xor q3 x2) x3) t0)
  let t3 := (xor x2 t0) && (!(xor x1 t0))
  let o3 := xor (xor (xor x1 x2) x3) t2
  let o2 := xor (xor (xor (xor x0 x2) x3) t0) t1
  let o1 := xor (xor (xor x0 x1) x2) t1
  let o0 := xor (xor (xor x0 x3) t0) t3
  packBits 4 (fun i => match i with | 0 => o0 | 1 => o1 | 2 => o2 | _ => o3)

/-- Saturnin 4-bit S-box (`internal-saturnin.c`: `saturnin_sbox`). -/
def saturninSbox (v : BitVec 4) : BitVec 4 :=
  let a := v.getLsbD 3; let b := v.getLsbD 2; let c := v.getLsbD 1; let d := v.getLsbD 0
  let a := xor a (b && c)
  let b := xor b (a || d)
  let d := xor d (b || c)
  let c := xor c (b && d)
  let b := xor b (a || c)
  let a := xor a (b || d)
  packBits 4 (fun i => match i with | 0 => d | 1 => c | 2 => b | _ => a)

/-- KNOT 4-bit S-box (`internal-knot.c`: `knot_sbox32`). -/
def knotSbox (v : BitVec 4) : BitVec 4 :=
  let a0 := v.getLsbD 0; let a1 := v.getLsbD 1; let a2 := v.getLsbD 2; let a3 := v.getLsbD 3
  let t1 := !a0
  let t3 := xor a2 (a1 && t1)
  let b3 := xor a3 t3
  let t6 := xor a3 t1
  let b2 := xor (a1 || a2) t6
  let t1' := xor a1 a3
  let b0 := xor t1' (t3 && t6)
  let b1 := xor t3 (b2 && t1')
  packBits 4 (fun i => match i with | 0 => b0 | 1 => b1 | 2 => b2 | _ => b3)

/-- Clyde-128 / Spook 4-bit S-box (`internal-spook.c`: `clyde128_sbox`). -/
def clydeSbox (v : BitVec 4) : BitVec 4 :=
  let s0 := v.getLsbD 0; let s1 := v.getLsbD 1; let s2 := v.getLsbD 2; let s3 := v.getLsbD 3
  let c := xor (s0 && s1) s2
  let d := xor (s3 && s0) s1
  let s2 := xor (c && d) s3
  let s3 := xor (c && s3) s0
  packBits 4 (fun i => match i with | 0 => d | 1 => c | 2 => s2 | _ => s3)

/-- Pyjamask-128 4-bit S-box (`internal-pyjamask.c`). -/
def pyjamaskSbox (v : BitVec 4) : BitVec 4 :=
  let s0 := v.getLsbD 3; let s1 := v.getLsbD 2; let s2 := v.getLsbD 1; let s3 := v.getLsbD 0
  let s0 := xor s0 s3; let s3 := xor s3 (s0 && s1); let s0 := xor s0 (s1 && s2)
  let s1 := xor s1 (s2 && s3); let s2 := xor s2 (s0 && s3)
  let s2 := xor s2 s1; let s1 := xor s1 s0; let s3 := !s3
  packBits 4 (fun i => match i with | 0 => s2 | 1 => s3 | 2 => s1 | _ => s0)

