      "verbatim_snippet": "static uint32_t spongent_sbox(uint32_t x3)\n{\n    uint32_t q0, q1, q2, q3, t0, t1, t2, t3;\n    uint32_t x2 = (x3 >> 1);\n    uint32_t x1 = (x2 >> 1);\n    uint32_t x0 = (x1 >> 1);\n    q0 = x0 ^ x2;\n    q1 = x1 ^ x2;\n    t0 = q0 & q1;\n    q2 = ~(x0 ^ x1 ^ x3 ^ t0);\n    t1 = q2 & ~x0;\n    q3 = x1 ^ t1;\n    t2 = q3 & (q3 ^ x2 ^ x3 ^ t0);\n    t3 = (x2 ^ t0) & ~(x1 ^ t0);\n    q0 = x1 ^ x2 ^ x3 ^ t2;\n    q1 = x0 ^ x2 ^ x3 ^ t0 ^ t1;\n    q2 = x0 ^ x1 ^ x2 ^ t1;\n    q3 = x0 ^ x3 ^ t0 ^ t3;\n    return ((q0 << 3) & 0x88888888U) | ((q1 << 2) & 0x44444444U) |\n           ((q2 << 1) & 0x22222222U) |  (q3       & 0x11111111U);\n}"
