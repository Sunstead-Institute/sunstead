    if len(sys.argv) < 2:
        emit(False, "usage: ./verify <task_id>", stage="lint")
    tid = sys.argv[1]
    if tid in CIRCUIT_TARGETS:
        rel_path, score_name, gates_name, outputs_name, width = CIRCUIT_TARGETS[tid]
        check_circuit(Path(__file__).resolve().parent / rel_path, score_name, gates_name, outputs_name, width)
    lean_verify(
        tid,
        lib_root="LwcSbox",
        frozen_files=FROZEN_FILES,
        tasks=TASKS,
        uses_mathlib=False,
        timeout_sec=60,
    )
