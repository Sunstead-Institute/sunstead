#!/usr/bin/env python3
"""Frozen verifier for `tier3-mldsa-arith`.

Checking logic lives in the trusted harness baked into the verifier image
(/opt/sunstead/sunstead_sandbox.py). The target file is linted (no std/core,
no macros, no calls into spec.rs), then the frozen integration test is built
and run as an unprivileged user in a scratch copy of the repo.
"""
import sys

sys.path.insert(0, "/opt/sunstead")
from sunstead_sandbox import emit, rust_verify  # noqa: E402

TASK_MAP = {
    'centered_mod': ('src/centered_mod.rs', 'verify_centered_mod', 'ct_strict'),
    'ct_select': ('src/ct_select.rs', 'verify_ct_select', 'ct_strict'),
    'montgomery_reduce': ('src/montgomery.rs', 'verify_montgomery_reduce', 'ct_strict'),
    'power2round': ('src/power2round.rs', 'verify_power2round', 'ct_strict'),
    'decompose_lowbits': ('src/decompose.rs', 'verify_decompose', 'ct_strict'),
    'add_reduce': ('src/add_reduce.rs', 'verify_add_reduce', 'ct_strict'),
    'sub_reduce': ('src/sub_reduce.rs', 'verify_sub_reduce', 'ct_strict'),
    'make_hint': ('src/make_hint.rs', 'verify_make_hint', 'ct_strict'),
    'use_hint': ('src/use_hint.rs', 'verify_use_hint', 'ct_strict'),
    'ct_butterfly': ('src/butterfly.rs', 'verify_ct_butterfly', 'ct_strict'),
    'inv_butterfly': ('src/inv_butterfly.rs', 'verify_inv_butterfly', 'ct_strict'),
}

CT_STRICT_FORBIDDEN = [
    ('\\bunsafe\\b', 'unsafe code is forbidden'),
    ('\\bif\\b', 'branching (`if`) is forbidden in constant-time code'),
    ('\\bmatch\\b', 'branching (`match`) is forbidden in constant-time code'),
    ('\\bwhile\\b|\\bfor\\b|\\bloop\\b', 'loops are forbidden in constant-time arithmetic'),
    ('(?<!/)%(?!=)', 'modulo operator `%` is variable-time on some CPUs'),
    ('(?<!/)/(?![/*])', 'division operator `/` is variable-time on hardware'),
    ('\\b(?:todo|unimplemented|panic)!', 'panicking stubs are forbidden'),
    ('\\basm!', 'inline assembly is forbidden'),
]

PROFILES = {"ct_strict": CT_STRICT_FORBIDDEN}

ALLOWED_MODULES = {'butterfly', 'decompose', 'ct_select', 'centered_mod', 'sub_reduce', 'power2round', 'use_hint', 'add_reduce', 'montgomery', 'make_hint', 'inv_butterfly'}

SUMMARY = "ML-DSA `{task_id}` passed constant-time hygiene + exhaustive Rust tests"


if __name__ == "__main__":
    if len(sys.argv) < 2:
        emit(False, "usage: ./verify <task_id>")
    rust_verify(sys.argv[1], tasks=TASK_MAP, profiles=PROFILES,
                allowed_modules=ALLOWED_MODULES, summary_fmt=SUMMARY)
