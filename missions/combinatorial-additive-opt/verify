        emit(False, "usage: ./verify <task_id>", stage="lint")
    task_id = sys.argv[1]
    if task_id in SET_TARGETS:
        kind, rel_path, score_name, set_name, limit = SET_TARGETS[task_id]
        check_set_file(kind, Path(__file__).resolve().parent / rel_path, score_name, set_name, limit)
