MAX_BYTES = 65536
MAX_CODEWORDS = 1024


def check_code_file(path: Path, score_name: str, words_name: str, n: int) -> None:
    if not path.is_file():
        emit(False, f"Missing code file: {path.name}", stage="lint")
    raw = path.read_bytes()
    if len(raw) > MAX_BYTES:
        emit(False, f"Code file exceeds {MAX_BYTES} bytes", stage="lint")
    try:
        text = raw.decode("utf-8")
    except UnicodeDecodeError:
        emit(False, "Code file must be valid UTF-8", stage="lint")

    nat = r"(?:0|[1-9][0-9]{0,9}|0x[0-9a-fA-F]{1,8})"
    header_re = (
        rf"\s*def\s+{re.escape(score_name)}\s*:\s*Nat\s*:=\s*({nat})\s*\n"
        rf"\s*def\s+{re.escape(words_name)}\s*:\s*List\s+Nat\s*:=\s*\[\s*(.*?)\s*\]\s*"
    )
    match = re.fullmatch(header_re, text, re.DOTALL)
    if not match:
        emit(
            False,
            f"Expected only literal definitions for {score_name} and {words_name}",
            stage="lint",
        )
    score_val = int(match.group(1), 0)
    body = match.group(2)
    if not body or not re.fullmatch(rf"{nat}(?:\s*,\s*{nat}){{0,{MAX_CODEWORDS - 1}}}", body):
        emit(
            False,
            f"Expected 1 to {MAX_CODEWORDS} literal codeword naturals",
            stage="lint",
        )
    vals = [int(tok, 0) for tok in re.findall(nat, body)]
    if len(vals) != score_val:
        emit(False, f"Score {score_val} does not match codeword count {len(vals)}", stage="lint")
    limit = 1 << n
    for v in vals:
        if v >= limit:
            emit(False, f"Codeword {v} exceeds n={n} bit width (< {limit})", stage="lint")


