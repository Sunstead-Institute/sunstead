namespace StdSbox

/-! ## Generic `BitVec w` Packing Helpers -/

/-- `j`-th standard basis vector `1 <<< j` in `BitVec w`. -/
def basisVec (w j : Nat) : BitVec w :=
  (1#w) <<< j

private theorem basisVec_getLsbD (w j i : Nat) :
    (basisVec w j).getLsbD i = (decide (i < w) && decide (i = j)) := by
  unfold basisVec
  rw [BitVec.getLsbD_shiftLeft]
  by_cases hi : i < w
  · by_cases hij : i = j
    · subst hij
      have h0 : 0 < w := by omega
      simp [hi, h0]
    · by_cases hlt : i < j
      · simp [hi, hij, hlt]
      · have hpos : i - j ≠ 0 := by omega
        have htb : Nat.testBit 1 (i - j) = false := by
          cases hm : i - j with
          | zero => omega
          | succ m => simp [Nat.testBit_succ]
        simp [hi, hij, hlt, BitVec.getLsbD_ofNat, htb]
  · simp [hi]

/-- Pack `k` LSB-first bits `f 0, ..., f (k - 1)` into a `BitVec w`. -/
def packBitsAux (w : Nat) (f : Nat → Bool) : Nat → BitVec w
  | 0 => 0#w
  | k + 1 => packBitsAux w f k ^^^ (if f k then basisVec w k else 0#w)

/-- Pack `w` LSB-first bits `f 0, ..., f (w - 1)` into a `BitVec w`. -/
def packBits (w : Nat) (f : Nat → Bool) : BitVec w :=
  packBitsAux w f w

private theorem packBitsAux_getLsbD (w : Nat) (f : Nat → Bool) (i : Nat) :
    ∀ k, (packBitsAux w f k).getLsbD i = if i < k ∧ i < w then f i else false
  | 0 => by simp [packBitsAux]
  | k + 1 => by
    simp only [packBitsAux, BitVec.getLsbD_xor, packBitsAux_getLsbD w f i k]
    by_cases hlt : i < k
    · have hne : i ≠ k := by omega
      have hlt' : i < k + 1 := by omega
      cases f k <;> simp [hlt, hlt', hne, basisVec_getLsbD]
    · by_cases heq : i = k
      · subst heq
        by_cases hw : i < w
        · cases f i <;> simp [hw, basisVec_getLsbD]
        · cases f i <;> simp [hw, basisVec_getLsbD]
      · have hgt : ¬ (i < k + 1) := by omega
        cases f k <;> simp [hlt, hgt, heq, basisVec_getLsbD]

theorem packBits_getLsbD (w : Nat) (f : Nat → Bool) (i : Nat) :
    (packBits w f).getLsbD i = if i < w then f i else false := by
  simpa [packBits] using packBitsAux_getLsbD w f i w

/-! ## Straight-Line Boolean Circuit Semantics (`{{xor, xnor, and, not}}`) -/

/-- Gate semantics over `{0 = xor, 1 = xnor, 2 = and, 3 = not}`. -/
def evalGate (op : Nat) (v1 v2 : Bool) : Bool :=
  match op with
  | 0 => xor v1 v2
  | 1 => !(xor v1 v2)
  | 2 => v1 && v2
  | 3 => !v1
  | _ => false

/-- Push input bits `x[0] .. x[k-1]` into an `Array Bool`. -/
def initWiresAux {w : Nat} (x : BitVec w) : Nat → Array Bool
  | 0 => #[]
  | k + 1 => (initWiresAux x k).push (x.getLsbD k)

/-- Input wires `0 .. w-1` hold input bits `x[0] .. x[w-1]` (LSB-first). -/
def initWires (w : Nat) (x : BitVec w) : Array Bool :=
  initWiresAux x w

/-- Evaluate gates in order; gate `i` (`0`-indexed) produces wire `w + i`. -/
def evalWiresAux (wires : Array Bool) : List (Nat × Nat × Nat) → Array Bool
  | [] => wires
  | (op, w1, w2) :: rest =>
    let v := evalGate op (wires.getD w1 false) (wires.getD w2 false)
    evalWiresAux (wires.push v) rest

/-- Evaluate a straight-line Boolean circuit `(gates, outputs)` on `x : BitVec w`. -/
def evalCircuit (w : Nat) (gates : List (Nat × Nat × Nat)) (outputs : List Nat)
    (x : BitVec w) : BitVec w :=
  let wires := evalWiresAux (initWires w x) gates
  packBits w (fun i => wires.getD (outputs.getD i 0) false)

/-- Check that every gate `i` has `op < 4` and strictly causal wire inputs `< n + i`. -/
def wellFormedGates (n : Nat) : List (Nat × Nat × Nat) → Bool
  | [] => true
  | (op, w1, w2) :: rest =>
    (op < 4 && w1 < n && w2 < n) && wellFormedGates (n + 1) rest

/-- Check `outputs.length == w`, valid opcodes `< 4`, causal gate inputs, and valid output indices. -/
def wellFormed (w : Nat) (gates : List (Nat × Nat × Nat)) (outputs : List Nat) : Bool :=
  let numWires := w + gates.length
  outputs.length == w && wellFormedGates w gates && outputs.all (fun o => o < numWires)

/-- Count of AND (`op == 2`) gates (multiplicative complexity). -/
def andCount : List (Nat × Nat × Nat) → Nat
  | [] => 0
  | (op, _, _) :: rest => (if op == 2 then 1 else 0) + andCount rest

/-- Lookup wire depth in a reversed depth list of length `len`. -/
def getRevNat (len : Nat) (rev : List Nat) (i : Nat) : Nat :=
  if i < len then rev.getD (len - 1 - i) 0 else 0

/-- Compute the multiplicative (AND) depth of every wire: inputs have depth `0`,
linear/affine gates `{xor, xnor, not}` preserve max input depth, and `and` adds `1`. -/
def andDepthWiresAux (len : Nat) (revDepths : List Nat) :
    List (Nat × Nat × Nat) → Nat × List Nat
  | [] => (len, revDepths)
  | (op, w1, w2) :: rest =>
    let d1 := getRevNat len revDepths w1
    let d2 := getRevNat len revDepths w2
    let d :=
      if op == 2 then 1 + max d1 d2
      else if op == 3 then d1
      else max d1 d2
    andDepthWiresAux (len + 1) (d :: revDepths) rest

/-- Maximum AND-depth across the circuit output wires. -/
def maxOutputDepth (len : Nat) (revDepths : List Nat) : List Nat → Nat
  | [] => 0
  | o :: os => max (getRevNat len revDepths o) (maxOutputDepth len revDepths os)

/-- Multiplicative depth (AND-depth) of a straight-line Boolean circuit (critical for masking/MPC/FHE). -/
def andDepth (w : Nat) (gates : List (Nat × Nat × Nat)) (outputs : List Nat) : Nat :=
  let (len, revDepths) := andDepthWiresAux w (List.replicate w 0) gates
  maxOutputDepth len revDepths outputs

/-- Existence of a well-formed circuit computing `target` with exact total gate count `n`. -/
def ValidTotalCircuit (w : Nat) (target : BitVec w → BitVec w) (n : Nat) : Prop :=
  ∃ gates outputs,
    wellFormed w gates outputs = true ∧
    gates.length = n ∧
    ∀ x : BitVec w, evalCircuit w gates outputs x = target x

/-- Existence of a well-formed circuit computing `target` with exact AND gate count `n`. -/
def ValidAndCircuit (w : Nat) (target : BitVec w → BitVec w) (n : Nat) : Prop :=
  ∃ gates outputs,
    wellFormed w gates outputs = true ∧
    andCount gates = n ∧
    ∀ x : BitVec w, evalCircuit w gates outputs x = target x

/-- Existence of a well-formed circuit computing `target` with exact multiplicative depth (AND-depth) `d`. -/
def ValidAndDepthCircuit (w : Nat) (target : BitVec w → BitVec w) (d : Nat) : Prop :=
  ∃ gates outputs,
    wellFormed w gates outputs = true ∧
    andDepth w gates outputs = d ∧
    ∀ x : BitVec w, evalCircuit w gates outputs x = target x

/-! ## Universal Bit-Sliced `BitVec (2^w)` Kernel Evaluator -/

def evalGateBV {m : Nat} (op : Nat) (v1 v2 : BitVec m) : BitVec m :=
  match op with
  | 0 => v1 ^^^ v2
  | 1 => ~~~(v1 ^^^ v2)
  | 2 => v1 &&& v2
  | 3 => ~~~v1
  | _ => 0#m

def getRevBV {m : Nat} (len : Nat) (revWires : List (BitVec m)) (i : Nat) : BitVec m :=
  if i < len then revWires.getD (len - 1 - i) 0#m else 0#m

def evalWiresBVAux {m : Nat} (len : Nat) (revWires : List (BitVec m)) :
    List (Nat × Nat × Nat) → Nat × List (BitVec m)
  | [] => (len, revWires)
  | (op, w1, w2) :: rest =>
    let v := evalGateBV op (getRevBV len revWires w1) (getRevBV len revWires w2)
    evalWiresBVAux (len + 1) (v :: revWires) rest

def checkOutputsBV {m : Nat} (len : Nat) (revWires : List (BitVec m)) :
    List (BitVec m) → List Nat → Bool
  | [], [] => true
  | t :: ts, o :: os =>
    (getRevBV len revWires o == t) && checkOutputsBV len revWires ts os
  | _, _ => false

/-- Evaluate all `2^w` inputs simultaneously as `(2^w)`-bit truth tables and compare to `table`. -/
def checkCircuitBV (w : Nat) (initRev : List (BitVec (2 ^ w))) (table : List (BitVec (2 ^ w)))
    (gates : List (Nat × Nat × Nat)) (outputs : List Nat) : Bool :=
  let (len, wires) := evalWiresBVAux w initRev gates
  checkOutputsBV len wires table outputs

private theorem evalGateBV_getLsbD {w : Nat} (op : Nat) (v1 v2 : BitVec (2 ^ w)) (x : BitVec w) :
    (evalGateBV op v1 v2).getLsbD x.toNat =
      evalGate op (v1.getLsbD x.toNat) (v2.getLsbD x.toNat) := by
  have hx : x.toNat < 2 ^ w := x.isLt
  match op with
  | 0 => simp [evalGateBV, evalGate]
  | 1 => simp [evalGateBV, evalGate, hx]
  | 2 => simp [evalGateBV, evalGate]
  | 3 => simp [evalGateBV, evalGate, hx]
  | _ + 4 => simp [evalGateBV, evalGate]

private theorem array_getD_push_eq {α : Type} (a : Array α) (v d : α) (i : Nat) :
    (a.push v).getD i d = if i < a.size then a.getD i d else if i = a.size then v else d := by
  by_cases h1 : i < a.size
  · have hlt : i < (a.push v).size := by rw [Array.size_push]; omega
    simp only [Array.getD, h1, hlt, dite_true, ite_true]
    exact Array.getElem_push_lt h1
  · by_cases h2 : i = a.size
    · subst h2
      have hlt : a.size < (a.push v).size := by rw [Array.size_push]; omega
      simp only [Array.getD, h1, hlt, dite_true, ite_false, ite_true]
      exact Array.getElem_push_eq
    · have hge : ¬ (i < (a.push v).size) := by rw [Array.size_push]; omega
      simp only [Array.getD, h1, h2, hge, dite_false, ite_false]

private theorem getRevBV_cons {m : Nat} (len : Nat) (revWires : List (BitVec m))
    (v : BitVec m) (i : Nat) :
    getRevBV (len + 1) (v :: revWires) i =
      if i < len then getRevBV len revWires i else if i = len then v else 0#m := by
  unfold getRevBV
  by_cases h1 : i < len
  · have hlt : i < len + 1 := by omega
    have hidx : len + 1 - 1 - i = (len - 1 - i) + 1 := by omega
    simp only [h1, hlt, ite_true, hidx, List.getD_cons_succ]
  · by_cases h2 : i = len
    · subst h2
      have hlt : i < i + 1 := by omega
      have hidx : i + 1 - 1 - i = 0 := by omega
      simp only [h1, hlt, ite_false, ite_true, hidx, List.getD_cons_zero]
    · have hge : ¬ (i < len + 1) := by omega
      simp only [h1, h2, hge, ite_false]

private theorem initWiresAux_size {w : Nat} (x : BitVec w) :
    ∀ k, (initWiresAux x k).size = k
  | 0 => rfl
  | k + 1 => by simp [initWiresAux, Array.size_push, initWiresAux_size x k]

private theorem initWiresAux_getD {w : Nat} (x : BitVec w) (i : Nat) :
    ∀ k, (initWiresAux x k).getD i false = if i < k then x.getLsbD i else false
  | 0 => by simp [initWiresAux, Array.getD]
  | k + 1 => by
    rw [initWiresAux, array_getD_push_eq, initWiresAux_size x k, initWiresAux_getD x i k]
    by_cases h1 : i < k
    · have hlt : i < k + 1 := by omega
      simp [h1, hlt]
    · by_cases h2 : i = k
      · subst h2; simp
      · have hgt : ¬ (i < k + 1) := by omega
        simp [h1, h2, hgt]

private theorem evalWiresBVAux_getLsbD {w : Nat} (gates : List (Nat × Nat × Nat))
    (len : Nat) (revWires : List (BitVec (2 ^ w))) (wires : Array Bool) (x : BitVec w)
    (hsz : len = wires.size)
    (hinv : ∀ i, (getRevBV len revWires i).getLsbD x.toNat = wires.getD i false) :
    let res := evalWiresBVAux len revWires gates
    ∀ i, (getRevBV res.1 res.2 i).getLsbD x.toNat =
      (evalWiresAux wires gates).getD i false := by
  induction gates generalizing len revWires wires with
  | nil => exact hinv
  | cons g rest ih =>
    rcases g with ⟨op, a, b⟩
    simp only [evalWiresBVAux, evalWiresAux]
    apply ih
    · simp [hsz]
    · intro i
      rw [getRevBV_cons, array_getD_push_eq, hsz]
      by_cases h1 : i < wires.size
      · simp only [h1, ite_true]; rw [← hsz]; exact hinv i
      · by_cases h2 : i = wires.size
        · subst h2
          simp only [Nat.lt_irrefl, ite_false, ite_true]
          rw [evalGateBV_getLsbD, ← hsz, hinv a, hinv b]
        · simp only [h1, h2, ite_false]; simp

private theorem checkOutputsBV_sound {m : Nat} (len : Nat) (revWires : List (BitVec m)) :
    ∀ (table : List (BitVec m)) (outputs : List Nat),
      checkOutputsBV len revWires table outputs = true →
      ∀ i, i < table.length →
        getRevBV len revWires (outputs.getD i 0) = table.getD i 0#m
  | [], [], _, _, hi => by simp at hi
  | [], _ :: _, h, _, _ => by simp [checkOutputsBV] at h
  | _ :: _, [], h, _, _ => by simp [checkOutputsBV] at h
  | t :: ts, o :: os, h, 0, _ => by
    simp only [checkOutputsBV, Bool.and_eq_true, beq_iff_eq] at h
    simpa [List.getD] using h.1
  | t :: ts, o :: os, h, i + 1, hi => by
    simp only [checkOutputsBV, Bool.and_eq_true, beq_iff_eq] at h
    have hi' : i < ts.length := by simpa using hi
    simpa [List.getD] using checkOutputsBV_sound len revWires ts os h.2 i hi'

/-- Check that `initRev` encodes the `w` identity input bit truth tables on `0 .. 2^w - 1`. -/
def checkInitBitsAux (w : Nat) (initRev : List (BitVec (2 ^ w))) (x : Nat) : Nat → Bool
  | 0 => true
  | b + 1 => ((getRevBV w initRev b).getLsbD x == x.testBit b) && checkInitBitsAux w initRev x b

def checkInitAux (w : Nat) (initRev : List (BitVec (2 ^ w))) : Nat → Bool
  | 0 => true
  | k + 1 => checkInitBitsAux w initRev k w && checkInitAux w initRev k

def checkInit (w : Nat) (initRev : List (BitVec (2 ^ w))) : Bool :=
  checkInitAux w initRev (2 ^ w)

private theorem checkInitBitsAux_sound (w : Nat) (initRev : List (BitVec (2 ^ w))) (x : Nat) :
    ∀ m, checkInitBitsAux w initRev x m = true →
      ∀ b, b < m → (getRevBV w initRev b).getLsbD x = x.testBit b
  | 0, _, _, hb => by omega
  | m + 1, h, b, hb => by
    simp only [checkInitBitsAux, Bool.and_eq_true, beq_iff_eq] at h
    by_cases hlt : b < m
    · exact checkInitBitsAux_sound w initRev x m h.2 b hlt
    · have heq : b = m := by omega
      subst heq; exact h.1

private theorem checkInitAux_sound (w : Nat) (initRev : List (BitVec (2 ^ w))) :
    ∀ n, checkInitAux w initRev n = true →
      ∀ x, x < n → ∀ b, b < w → (getRevBV w initRev b).getLsbD x = x.testBit b
  | 0, _, _, hx, _, _ => by omega
  | n + 1, h, x, hx, b, hb => by
    simp only [checkInitAux, Bool.and_eq_true] at h
    by_cases hlt : x < n
    · exact checkInitAux_sound w initRev n h.2 x hlt b hb
    · have heq : x = n := by omega
      subst heq
      exact checkInitBitsAux_sound w initRev x w h.1 b hb

/-- Check that a bit-sliced truth table `table` of length `w` agrees pointwise with `fn` on all `2^w` inputs. -/
def checkTableBitsAux (w : Nat) (table : List (BitVec (2 ^ w))) (fn : BitVec w → BitVec w)
    (x : Nat) : Nat → Bool
  | 0 => true
  | b + 1 =>
    ((table.getD b 0#(2 ^ w)).getLsbD x == (fn (BitVec.ofNat w x)).getLsbD b) &&
      checkTableBitsAux w table fn x b

def checkTableAux (w : Nat) (table : List (BitVec (2 ^ w))) (fn : BitVec w → BitVec w) : Nat → Bool
  | 0 => true
  | k + 1 => checkTableBitsAux w table fn k w && checkTableAux w table fn k

def checkTableEq (w : Nat) (table : List (BitVec (2 ^ w))) (fn : BitVec w → BitVec w) : Bool :=
  (table.length == w) && checkTableAux w table fn (2 ^ w)

private theorem checkTableBitsAux_sound (w : Nat) (table : List (BitVec (2 ^ w)))
    (fn : BitVec w → BitVec w) (x : Nat) :
    ∀ m, checkTableBitsAux w table fn x m = true →
      ∀ b, b < m → (table.getD b 0#(2 ^ w)).getLsbD x = (fn (BitVec.ofNat w x)).getLsbD b
  | 0, _, _, hb => by omega
  | m + 1, h, b, hb => by
    simp only [checkTableBitsAux, Bool.and_eq_true, beq_iff_eq] at h
    by_cases hlt : b < m
    · exact checkTableBitsAux_sound w table fn x m h.2 b hlt
    · have heq : b = m := by omega
      subst heq; exact h.1

private theorem checkTableAux_sound (w : Nat) (table : List (BitVec (2 ^ w)))
    (fn : BitVec w → BitVec w) :
    ∀ n, checkTableAux w table fn n = true →
      ∀ x, x < n → ∀ b, b < w → (table.getD b 0#(2 ^ w)).getLsbD x = (fn (BitVec.ofNat w x)).getLsbD b
  | 0, _, _, hx, _, _ => by omega
  | n + 1, h, x, hx, b, hb => by
    simp only [checkTableAux, Bool.and_eq_true] at h
    by_cases hlt : x < n
    · exact checkTableAux_sound w table fn n h.2 x hlt b hb
    · have heq : x = n := by omega
      subst heq
      exact checkTableBitsAux_sound w table fn x w h.1 b hb

/-- **Universal Bit-Sliced Circuit Verification Soundness Theorem**:
If `checkInit`, `checkTableEq`, and `checkCircuitBV` all pass, then `evalCircuit w gates outputs`
equals `target` on all `2^w` inputs. -/
theorem evalCircuit_eq_of_checkCircuitBV
    (w : Nat) (initRev : List (BitVec (2 ^ w))) (table : List (BitVec (2 ^ w)))
    (target : BitVec w → BitVec w)
    (hinit : checkInit w initRev = true)
    (htable : checkTableEq w table target = true)
    (gates : List (Nat × Nat × Nat)) (outputs : List Nat)
    (hcheck : checkCircuitBV w initRev table gates outputs = true) :
    ∀ x : BitVec w, evalCircuit w gates outputs x = target x := by
  simp only [checkTableEq, Bool.and_eq_true, beq_iff_eq] at htable
  rcases htable with ⟨htlen, htbits⟩
  intro x
  have hinv0 : ∀ i, (getRevBV w initRev i).getLsbD x.toNat = (initWires w x).getD i false := by
    intro i
    rw [initWires, initWiresAux_getD x i w]
    by_cases hi : i < w
    · simp only [hi, ite_true]
      have hb := checkInitAux_sound w initRev (2 ^ w) hinit x.toNat x.isLt i hi
      rw [hb]
      rfl
    · simp [getRevBV, hi]
  have hsz : w = (initWires w x).size := (initWiresAux_size x w).symm
  have hwires := evalWiresBVAux_getLsbD gates w initRev (initWires w x) x hsz hinv0
  unfold checkCircuitBV at hcheck
  have hmatch := checkOutputsBV_sound (evalWiresBVAux w initRev gates).1
    (evalWiresBVAux w initRev gates).2 table outputs hcheck
  apply BitVec.eq_of_getLsbD_eq
  intro b hb
  simp only [evalCircuit, packBits_getLsbD, hb, ite_true]
  have hb' : b < table.length := by omega
  rw [← hwires (outputs.getD b 0), hmatch b hb']
  have ht := checkTableAux_sound w table target (2 ^ w) htbits x.toNat x.isLt b hb
  simpa [BitVec.ofNat_toNat] using ht

