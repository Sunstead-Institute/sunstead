/-! ### Bit-Sliced `GF(2^8)` Algebraic Equivalence Proofs (All 256 Bytes in Parallel) -/

structure Byte256 where
  b0 : BitVec 256
  b1 : BitVec 256
  b2 : BitVec 256
  b3 : BitVec 256
  b4 : BitVec 256
  b5 : BitVec 256
  b6 : BitVec 256
  b7 : BitVec 256
  deriving DecidableEq

def Byte256.zero : Byte256 := ⟨0#256, 0#256, 0#256, 0#256, 0#256, 0#256, 0#256, 0#256⟩
def Byte256.xor (a b : Byte256) : Byte256 :=
  ⟨a.b0 ^^^ b.b0, a.b1 ^^^ b.b1, a.b2 ^^^ b.b2, a.b3 ^^^ b.b3,
   a.b4 ^^^ b.b4, a.b5 ^^^ b.b5, a.b6 ^^^ b.b6, a.b7 ^^^ b.b7⟩
def Byte256.mask (m : BitVec 256) (a : Byte256) : Byte256 :=
  ⟨m &&& a.b0, m &&& a.b1, m &&& a.b2, m &&& a.b3,
   m &&& a.b4, m &&& a.b5, m &&& a.b6, m &&& a.b7⟩
def Byte256.const (c : BitVec 8) : Byte256 :=
  let f (b : Bool) : BitVec 256 := if b then BitVec.allOnes 256 else 0#256
  ⟨f (c.getLsbD 0), f (c.getLsbD 1), f (c.getLsbD 2), f (c.getLsbD 3),
   f (c.getLsbD 4), f (c.getLsbD 5), f (c.getLsbD 6), f (c.getLsbD 7)⟩
def Byte256.shl1 (a : Byte256) : Byte256 := ⟨0#256, a.b0, a.b1, a.b2, a.b3, a.b4, a.b5, a.b6⟩
def Byte256.shr1 (a : Byte256) : Byte256 := ⟨a.b1, a.b2, a.b3, a.b4, a.b5, a.b6, a.b7, 0#256⟩
def Byte256.gfXtime (a : Byte256) : Byte256 := Byte256.xor a.shl1 (Byte256.mask a.b7 (Byte256.const 0x1b#8))
def Byte256.gfMulAux : Nat → Byte256 → Byte256 → Byte256 → Byte256
  | 0, _, _, acc => acc
  | n + 1, a, b, acc => Byte256.gfMulAux n a.gfXtime b.shr1 (Byte256.xor acc (Byte256.mask b.b0 a))
def Byte256.gfMul (a b : Byte256) : Byte256 := Byte256.gfMulAux 8 a b Byte256.zero
def Byte256.gfInv (x : Byte256) : Byte256 :=
  let x2 := x.gfMul x; let x3 := x2.gfMul x; let x6 := x3.gfMul x3; let x12 := x6.gfMul x6
  let x15 := x12.gfMul x3; let x30 := x15.gfMul x15; let x60 := x30.gfMul x30
  let x120 := x60.gfMul x60; let x126 := x120.gfMul x6; let x127 := x126.gfMul x
  x127.gfMul x127
def Byte256.parityMask (r : BitVec 8) (a : Byte256) : BitVec 256 :=
  let s (b : Bool) (v : BitVec 256) : BitVec 256 := if b then v else 0#256
  s (r.getLsbD 0) a.b0 ^^^ (s (r.getLsbD 1) a.b1 ^^^ (s (r.getLsbD 2) a.b2 ^^^
    (s (r.getLsbD 3) a.b3 ^^^ (s (r.getLsbD 4) a.b4 ^^^ (s (r.getLsbD 5) a.b5 ^^^
      (s (r.getLsbD 6) a.b6 ^^^ s (r.getLsbD 7) a.b7))))))
def Byte256.linMap8 (r0 r1 r2 r3 r4 r5 r6 r7 : BitVec 8) (a : Byte256) : Byte256 :=
  ⟨a.parityMask r0, a.parityMask r1, a.parityMask r2, a.parityMask r3,
   a.parityMask r4, a.parityMask r5, a.parityMask r6, a.parityMask r7⟩
def Byte256.toList (v : Byte256) : List (BitVec 256) := [v.b0, v.b1, v.b2, v.b3, v.b4, v.b5, v.b6, v.b7]

