/-- ISO/IEC 10118-3 Whirlpool 4-bit mini-boxes `E`, `E^-1`, and `R`. -/
def wpMiniE : List Nat := [0x1, 0xb, 0x9, 0xc, 0xd, 0x6, 0xf, 0x3, 0xe, 0x8, 0x7, 0x4, 0xa, 0x2, 0x5, 0x0]
def wpMiniEInv : List Nat := [0xf, 0x0, 0xd, 0x7, 0xb, 0xe, 0x5, 0xa, 0x9, 0x2, 0xc, 0x1, 0x3, 0x4, 0x8, 0x6]
def wpMiniR : List Nat := [0x7, 0xc, 0xb, 0xd, 0xe, 0x4, 0x9, 0xf, 0x6, 0x3, 0x8, 0xa, 0x2, 0x5, 0x1, 0x0]

/-- Algebraic Whirlpool 8-bit S-box via ISO/IEC 10118-3 three-layer mini-box network. -/
def whirlpoolSbox (x : BitVec 8) : BitVec 8 :=
  let u := (x.toNat >>> 4) &&& 0xF
  let v := x.toNat &&& 0xF
  let u1 := wpMiniE.getD u 0
  let v1 := wpMiniEInv.getD v 0
  let t := wpMiniR.getD (u1 ^^^ v1) 0
  let u2 := wpMiniE.getD (u1 ^^^ t) 0
  let v2 := wpMiniEInv.getD (v1 ^^^ t) 0
  BitVec.ofNat 8 ((u2 <<< 4) ||| v2)

