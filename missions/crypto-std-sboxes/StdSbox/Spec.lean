  decide +kernel

/-- Bit-sliced algebraic `GF(2^8)` verification of ARIA `InvS2` (`(M^-1 · (x ⊕ 0xe2))^(-1)`). -/
theorem ariaInvS2_algebraic_256 :
    (Byte256.linMap8 0x18#8 0x64#8 0x50#8 0xc7#8 0x37#8 0xd6#8 0xbd#8 0xc9#8
      (Byte256.xor idByte256 (Byte256.const 0xe2#8))).gfInv = ariaInvS2Byte256 := by
  decide +kernel

private def checkListFnAux (xs : List Nat) (fn : BitVec 8 → BitVec 8) : Nat → Bool
  | 0 => true
  | k + 1 => ((fn (BitVec.ofNat 8 k)).toNat == xs.getD k 0) && checkListFnAux xs fn k

private def checkInvPairAux (f g : BitVec 8 → BitVec 8) : Nat → Bool
  | 0 => true
  | k + 1 =>
    let b := BitVec.ofNat 8 k
    (g (f b) == b) && (f (g b) == b) && checkInvPairAux f g k

theorem whirlpool_matches_openssl :
    opensslWhirlpoolList.length = 256 ∧ checkListFnAux opensslWhirlpoolList whirlpoolSbox 256 = true := by
  decide +kernel

theorem ariaS2_inv_bijection :
    opensslAriaS2List.length = 256 ∧ opensslAriaInvS2List.length = 256 ∧
    checkInvPairAux ariaS2Sbox ariaInvS2Sbox 256 = true := by
  decide +kernel

