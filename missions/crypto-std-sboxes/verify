MAX_BYTES = 32768
MAX_GATES = 1024


def check_circuit(path, score_name, gates_name, outputs_name, width):
    if not path.is_file():
        emit(False, f"Missing circuit file: {path.name}", stage="lint")
    raw = path.read_bytes()
    if len(raw) > MAX_BYTES:
        emit(False, f"Circuit file exceeds {MAX_BYTES} bytes", stage="lint")
    try:
        text = raw.decode("utf-8")
    except UnicodeDecodeError:
        emit(False, "Circuit file must be valid UTF-8", stage="lint")
    nat = r"(?:0|[1-9][0-9]{0,3})"
    triple = rf"\(\s*{nat}\s*,\s*{nat}\s*,\s*{nat}\s*\)"
    header_re = (
        rf"\s*def\s+{re.escape(score_name)}\s*:\s*Nat\s*:=\s*({nat})\s*\n"
        rf"\s*def\s+{re.escape(gates_name)}\s*:\s*List\s*\(Nat\s*×\s*Nat\s*×\s*Nat\)\s*:=\s*\[\s*(.*?)\s*\]\s*\n"
        rf"\s*def\s+{re.escape(outputs_name)}\s*:\s*List\s+Nat\s*:=\s*\[\s*(.*?)\s*\]\s*"
    )
    match = re.fullmatch(header_re, text, re.DOTALL)
    if not match:
        emit(False, f"Expected only literal definitions for {score_name}, {gates_name}, and {outputs_name}", stage="lint")
    gates_body = match.group(2)
    outputs_body = match.group(3)
    if not gates_body or not re.fullmatch(rf"{triple}(?:\s*,\s*{triple}){{0,{MAX_GATES - 1}}}", gates_body):
        emit(False, f"Expected 1 to {MAX_GATES} literal (op, w1, w2) gate triples", stage="lint")
    if not re.fullmatch(rf"{nat}(?:\s*,\s*{nat}){{{width - 1}}}", outputs_body):
        emit(False, f"Expected exactly {width} literal output wire indices", stage="lint")


if __name__ == "__main__":
    if len(sys.argv) < 2:
        emit(False, "usage: ./verify <task_id>", stage="lint")
