#!/usr/bin/env python3
"""Frozen verifier for `tier1-metacomplexity-dag`.

All checking logic lives in the trusted harness baked into the verifier image
(/opt/sunstead/sunstead_sandbox.py + SunsteadCheck.lean). This file only lists
each task's module, the theorem that must prove it, and the frozen statement.
Contributor code is built as an unprivileged user; the verdict comes from a
Lean kernel replay of the compiled output, never from text the build printed.
"""
import sys

sys.path.insert(0, "/opt/sunstead")
from sunstead_sandbox import emit, lean_verify  # noqa: E402

LIB_ROOT = 'MetaComplexity'
FROZEN_FILES = ['MetaComplexity' + "/Spec.lean", "lakefile.toml", "lean-toolchain"]

TASKS = {
    'pigeonhole_fin': {
        'module': 'MetaComplexity.Pigeonhole',
        'theorem': 'MetaComplexity.no_inj_lt',
        'statement': """
def pigeonhole_fin : Prop :=
    ∀ {n m : Nat}, m < n → ∀ (f : Fin n → Fin m), ¬ MetaComplexity.Injective f
""",
    },
    'decoder_injective': {
        'module': 'MetaComplexity.DecoderInjective',
        'theorem': 'MetaComplexity.encode_injective_of_lossless',
        'statement': """
def decoder_injective : Prop :=
    ∀ {n k : Nat} (c : MetaComplexity.LosslessCompressor n k), MetaComplexity.Injective c.encode
""",
    },
    'bijection_card_eq': {
        'module': 'MetaComplexity.BijectionCard',
        'theorem': 'MetaComplexity.bij_card_eq',
        'statement': """
def bijection_card_eq : Prop :=
    ∀ {n m : Nat} (f : Fin n → Fin m) (g : Fin m → Fin n),
    (∀ x, g (f x) = x) → (∀ y, f (g y) = y) → n = m
""",
    },
    'incompressibility_theorem': {
        'module': 'MetaComplexity.Incompressibility',
        'theorem': 'MetaComplexity.no_universal_lossless_compressor',
        'statement': """
def incompressibility_theorem : Prop :=
    ∀ {n k : Nat}, k < n → MetaComplexity.LosslessCompressor n k → False
""",
    },
    'non_surjective_decoder': {
        'module': 'MetaComplexity.NonSurjective',
        'theorem': 'MetaComplexity.exists_incompressible_string',
        'statement': """
def non_surjective_decoder : Prop :=
    ∀ {n k : Nat}, k < n → ∀ (U : Fin (2 ^ k) → Fin (2 ^ n)),
    ∃ x : Fin (2 ^ n), ∀ p : Fin (2 ^ k), U p ≠ x
""",
    },
    'incompressible_density': {
        'module': 'MetaComplexity.IncompressibleDensity',
        'theorem': 'MetaComplexity.count_not_in_image_ge',
        'statement': """
def incompressible_density : Prop :=
    ∀ {m n : Nat} (U : Fin m → Fin n),
    n - m ≤ MetaComplexity.countFin n (fun x => !MetaComplexity.inImage U x)
""",
    },
    'count_complement_sum': {
        'module': 'MetaComplexity.CountComplement',
        'theorem': 'MetaComplexity.count_add_complement',
        'statement': """
def count_complement_sum : Prop :=
    ∀ (n : Nat) (P : Fin n → Bool),
    MetaComplexity.countFin n P + MetaComplexity.countFin n (fun x => !P x) = n
""",
    },
    'count_mono': {
        'module': 'MetaComplexity.CountMono',
        'theorem': 'MetaComplexity.count_le_of_imp',
        'statement': """
def count_mono : Prop :=
    ∀ {n : Nat} {P Q : Fin n → Bool},
    (∀ x : Fin n, P x = true → Q x = true) →
    MetaComplexity.countFin n P ≤ MetaComplexity.countFin n Q
""",
    },
    'union_bound_fin': {
        'module': 'MetaComplexity.UnionBound',
        'theorem': 'MetaComplexity.count_or_le_add',
        'statement': """
def union_bound_fin : Prop :=
    ∀ (n : Nat) (P Q : Fin n → Bool),
    MetaComplexity.countFin n (fun x => P x || Q x) ≤
    MetaComplexity.countFin n P + MetaComplexity.countFin n Q
""",
    },
    'exponential_incompressibility': {
        'module': 'MetaComplexity.ExpIncompressibility',
        'theorem': 'MetaComplexity.exp_incompressible_bound',
        'statement': """
def exponential_incompressibility : Prop :=
    ∀ {n c : Nat}, c ≤ n → ∀ (U : Fin (2 ^ (n - c)) → Fin (2 ^ n)),
    (2 ^ c - 1) * 2 ^ (n - c) ≤ MetaComplexity.countFin (2 ^ n) (fun x => !MetaComplexity.inImage U x) ∧
    MetaComplexity.countFin (2 ^ n) (MetaComplexity.inImage U) ≤ 2 ^ (n - c)
""",
    },
}

if __name__ == "__main__":
    if len(sys.argv) < 2:
        emit(False, "usage: ./verify <task_id>")
    lean_verify(sys.argv[1], lib_root=LIB_ROOT, frozen_files=FROZEN_FILES, tasks=TASKS)
