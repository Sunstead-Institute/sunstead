MAX_BYTES = 65536
MAX_VERTICES = 128


def check_graph_file(kind: str, path: Path, score_name: str, rows_name: str, fixed_n: int) -> None:
    if not path.is_file():
        emit(False, f"Missing graph file: {path.name}", stage="lint")
    raw = path.read_bytes()
    if len(raw) > MAX_BYTES:
        emit(False, f"Graph file exceeds {MAX_BYTES} bytes", stage="lint")
    try:
        text = raw.decode("utf-8")
    except UnicodeDecodeError:
        emit(False, "Graph file must be valid UTF-8", stage="lint")

    nat = r"(?:0|[1-9][0-9]{0,39}|0x[0-9a-fA-F]{1,32})"
    header_re = (
        rf"\s*def\s+{re.escape(score_name)}\s*:\s*Nat\s*:=\s*({nat})\s*\n"
        rf"\s*def\s+{re.escape(rows_name)}\s*:\s*List\s+Nat\s*:=\s*\[\s*(.*?)\s*\]\s*"
    )
    match = re.fullmatch(header_re, text, re.DOTALL)
    if not match:
        emit(False, f"Expected only literal definitions for {score_name} and {rows_name}", stage="lint")
    score_val = int(match.group(1), 0)
    body = match.group(2)
    if not body or not re.fullmatch(rf"{nat}(?:\s*,\s*{nat}){{0,{MAX_VERTICES - 1}}}", body):
        emit(False, f"Expected 1 to {MAX_VERTICES} literal adjacency bitmask naturals", stage="lint")
    rows = [int(tok, 0) for tok in re.findall(nat, body)]
    n = score_val if kind == "ramsey" else fixed_n
    if len(rows) != n:
        emit(False, f"Row count {len(rows)} does not match vertex count {n}", stage="lint")
    limit = 1 << n
    for r in rows:
        if r >= limit:
            emit(False, f"Adjacency row exceeds n={n} vertex bit width", stage="lint")


