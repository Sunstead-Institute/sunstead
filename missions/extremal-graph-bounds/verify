        emit(False, "usage: ./verify <task_id>", stage="lint")
    task_id = sys.argv[1]
    if task_id in GRAPH_TARGETS:
        kind, rel_path, score_name, rows_name, fixed_n = GRAPH_TARGETS[task_id]
        check_graph_file(kind, Path(__file__).resolve().parent / rel_path, score_name, rows_name, fixed_n)
    lean_verify(
        task_id,
        lib_root=LIB_ROOT,
        frozen_files=FROZEN_FILES,
        tasks=TASKS,
        uses_mathlib=False,
        timeout_sec=90,
    )
