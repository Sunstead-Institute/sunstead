#!/usr/bin/env python3
"""Frozen verifier for `onboarding-sandbox` (0-point pure Lean 4.36.0 protocol sandbox)."""
import sys

sys.path.insert(0, "/opt/sunstead")
from sunstead_sandbox import emit, lean_verify  # noqa: E402

LIB_ROOT = "OnboardingSandbox"
FROZEN_FILES = ["OnboardingSandbox/Spec.lean", "lakefile.toml", "lean-toolchain"]

TASKS = {
    "xor_involution": {
        "module": "OnboardingSandbox.XorInvolution",
        "theorem": "OnboardingSandbox.otp_dec_enc",
        "statement": """
def xor_involution : Prop :=
    ∀ {n : Nat} (m k : BitVec n), OnboardingSandbox.otpEnc (OnboardingSandbox.otpEnc m k) k = m
""",
    },
    "decoder_injective": {
        "module": "OnboardingSandbox.DecoderInjective",
        "theorem": "OnboardingSandbox.encode_injective_of_lossless",
        "statement": """
def decoder_injective : Prop :=
    ∀ {n k : Nat} (c : OnboardingSandbox.LosslessCompressor n k), OnboardingSandbox.Injective c.encode
""",
    },
    "pigeonhole_fin": {
        "module": "OnboardingSandbox.Pigeonhole",
        "theorem": "OnboardingSandbox.no_inj_lt",
        "statement": """
def pigeonhole_fin : Prop :=
    ∀ {n m : Nat}, m < n → ∀ (f : Fin n → Fin m), ¬ OnboardingSandbox.Injective f
""",
    },
    "incompressibility_theorem": {
        "module": "OnboardingSandbox.Incompressibility",
        "theorem": "OnboardingSandbox.no_universal_lossless_compressor",
        "statement": """
def incompressibility_theorem : Prop :=
    ∀ {n k : Nat}, k < n → OnboardingSandbox.LosslessCompressor n k → False
""",
    },
}

if __name__ == "__main__":
    if len(sys.argv) < 2:
        emit(False, "usage: ./verify <task_id>")
    lean_verify(sys.argv[1], lib_root=LIB_ROOT, frozen_files=FROZEN_FILES, tasks=TASKS)
