    if task_id in NET_TARGETS:
        rel_path, score_name, net_name = NET_TARGETS[task_id]
        check_network(Path(__file__).resolve().parent / rel_path, score_name, net_name)
    lean_verify(
        task_id,
        lib_root=LIB_ROOT,
        frozen_files=FROZEN_FILES,
        tasks=TASKS,
        uses_mathlib=False,
        timeout_sec=90,
