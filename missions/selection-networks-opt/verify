MAX_BYTES = 16384
MAX_COMPARATORS = 256


def check_network(path: Path, score_name: str, net_name: str) -> None:
    if not path.is_file():
        emit(False, f"Missing network file: {path.name}", stage="lint")
    raw = path.read_bytes()
    if len(raw) > MAX_BYTES:
        emit(False, f"Network file exceeds {MAX_BYTES} bytes", stage="lint")
    try:
        text = raw.decode("utf-8")
    except UnicodeDecodeError:
        emit(False, "Network file must be valid UTF-8", stage="lint")

    nat = r"(?:0|[1-9][0-9]{0,2})"
    pair = rf"\(\s*{nat}\s*,\s*{nat}\s*\)"
    header_re = (
        rf"\s*def\s+{re.escape(score_name)}\s*:\s*Nat\s*:=\s*({nat})\s*\n"
        rf"\s*def\s+{re.escape(net_name)}\s*:\s*List\s*\(Nat\s*×\s*Nat\)\s*:=\s*\[\s*(.*?)\s*\]\s*"
    )
    match = re.fullmatch(header_re, text, re.DOTALL)
    if not match:
        emit(False, f"Expected only literal definitions for {score_name} and {net_name}", stage="lint")
    net_body = match.group(2)
    if not net_body or not re.fullmatch(rf"{pair}(?:\s*,\s*{pair}){{0,{MAX_COMPARATORS - 1}}}", net_body):
        emit(False, f"Expected 1 to {MAX_COMPARATORS} literal (i, j) comparator pairs", stage="lint")


