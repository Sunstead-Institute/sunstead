    "depth_n16": ("SortDepth/Layers16.lean", "SortDepth.depth16", "SortDepth.layers16"),
}

MAX_BYTES = 16384
MAX_LAYERS = 32
MAX_COMPARATORS = 256

_NAT = r"(?:0|[1-9][0-9]{0,2})"
_PAIR_RE = re.compile(rf"\(\s*{_NAT}\s*,\s*{_NAT}\s*\)")
_WS_RE = re.compile(r"\s*")


def _skip_ws(s: str, pos: int) -> int:
    return _WS_RE.match(s, pos).end()


def check_layers(path: Path, depth_name: str, layers_name: str) -> None:
    # Restrict the editable source to concrete parallel-layer literals replayable outside Lean.
    if not path.is_file():
        emit(False, f"Missing layers file: {path.name}", stage="lint")
    raw = path.read_bytes()
    if len(raw) > MAX_BYTES:
        emit(False, f"Layers file exceeds {MAX_BYTES} bytes", stage="lint")
    try:
        text = raw.decode("utf-8")
    except UnicodeDecodeError:
        emit(False, "Layers file must be valid UTF-8", stage="lint")

    header_re = (
        rf"\s*def\s+{re.escape(depth_name)}\s*:\s*Nat\s*:=\s*({_NAT})\s*\n"
        rf"\s*def\s+{re.escape(layers_name)}\s*:\s*List\s*\(\s*List\s*\(Nat\s*×\s*Nat\)\s*\)\s*:=\s*\[(.*)\]\s*"
    )
    match = re.fullmatch(header_re, text, re.DOTALL)
    if not match:
        emit(
            False,
            f"Expected only literal definitions for {depth_name} and {layers_name}",
            stage="lint",
        )

    body = match.group(2)
    pos = _skip_ws(body, 0)
    end = len(body)
    if pos >= end:
        emit(
            False,
            f"Expected 1 to {MAX_LAYERS} non-empty parallel layers",
            stage="lint",
        )

    num_layers = 0
    total_comparators = 0
    while True:
        if pos >= end or body[pos] != "[":
            emit(
                False,
                f"Expected literal layer list `[ (i, j), ... ]` in {layers_name}",
                stage="lint",
            )
        pos = _skip_ws(body, pos + 1)
        layer_pairs = 0
        while True:
            pm = _PAIR_RE.match(body, pos)
            if not pm:
                emit(
                    False,
                    f"Expected non-empty literal (i, j) comparator pairs inside each layer of {layers_name}",
                    stage="lint",
                )
            layer_pairs += 1
            total_comparators += 1
            if total_comparators > MAX_COMPARATORS:
                emit(
                    False,
                    f"Total comparator count exceeds {MAX_COMPARATORS}",
                    stage="lint",
                )
            pos = _skip_ws(body, pm.end())
            if pos < end and body[pos] == ",":
                pos = _skip_ws(body, pos + 1)
                continue
            if pos < end and body[pos] == "]":
                pos = _skip_ws(body, pos + 1)
                break
            emit(
                False,
                f"Unexpected token inside layer of {layers_name}",
                stage="lint",
            )
        num_layers += 1
        if num_layers > MAX_LAYERS:
            emit(
                False,
                f"Layer count exceeds {MAX_LAYERS}",
                stage="lint",
            )
        if pos >= end:
            break
        if body[pos] != ",":
            emit(
                False,
                f"Expected `,` between layers in {layers_name}",
                stage="lint",
            )
        pos = _skip_ws(body, pos + 1)


if __name__ == "__main__":
    if len(sys.argv) < 2:
        emit(False, "usage: ./verify <task_id>", stage="lint")
    task_id = sys.argv[1]
    if task_id in LAYERS_TARGETS:
        rel_path, depth_name, layers_name = LAYERS_TARGETS[task_id]
        check_layers(
            Path(__file__).resolve().parent / rel_path,
            depth_name,
            layers_name,
        )
    lean_verify(
        task_id,
        lib_root="SortDepth",
        frozen_files=["SortDepth/Spec.lean", "UPSTREAM.json", "lakefile.toml", "lean-toolchain"],
        tasks=TASKS,
        uses_mathlib=False,
        timeout_sec=90,
    )
