MAX_BYTES = 65536
MAX_ROWS = 256
MAX_MARKS = 64


def check_design_file(kind: str, path: Path, score_name: str, data_name: str, k: int, v: int) -> None:
    if not path.is_file():
        emit(False, f"Missing design file: {path.name}", stage="lint")
    raw = path.read_bytes()
    if len(raw) > MAX_BYTES:
        emit(False, f"Design file exceeds {MAX_BYTES} bytes", stage="lint")
    try:
        text = raw.decode("utf-8")
    except UnicodeDecodeError:
        emit(False, "Design file must be valid UTF-8", stage="lint")

    nat = r"(?:0|[1-9][0-9]{0,5})"
    if kind == "golomb":
        header_re = (
            rf"\s*def\s+{re.escape(score_name)}\s*:\s*Nat\s*:=\s*({nat})\s*\n"
            rf"\s*def\s+{re.escape(data_name)}\s*:\s*List\s+Nat\s*:=\s*\[\s*(.*?)\s*\]\s*"
        )
        m = re.fullmatch(header_re, text, re.DOTALL)
        if not m:
            emit(False, f"Expected only literal definitions for {score_name} and {data_name}", stage="lint")
        body = m.group(2)
        if not body or not re.fullmatch(rf"{nat}(?:\s*,\s*{nat}){{0,{MAX_MARKS - 1}}}", body):
            emit(False, f"Expected 1 to {MAX_MARKS} literal mark naturals", stage="lint")
        marks = [int(tok) for tok in re.findall(nat, body)]
        if len(marks) != k:
            emit(False, f"Expected {k} marks, got {len(marks)}", stage="lint")
    else:
        header_re = (
            rf"\s*def\s+{re.escape(score_name)}\s*:\s*Nat\s*:=\s*({nat})\s*\n"
            rf"\s*def\s+{re.escape(data_name)}\s*:\s*List\s*\(\s*List\s+Nat\s*\)\s*:=\s*\[(.*)\]\s*"
        )
        m = re.fullmatch(header_re, text, re.DOTALL)
        if not m:
            emit(False, f"Expected only literal definitions for {score_name} and {data_name}", stage="lint")
        score_val = int(m.group(1))
        if score_val < 1 or score_val > MAX_ROWS:
            emit(False, f"Row count {score_val} out of range 1..{MAX_ROWS}", stage="lint")
        row_pat = rf"\[\s*{nat}(?:\s*,\s*{nat}){{{k - 1}}}\s*\]"
        body = m.group(2).strip()
        if not body or not re.fullmatch(rf"{row_pat}(?:\s*,\s*{row_pat}){{0,{MAX_ROWS - 1}}}", body):
            emit(False, f"Expected literal rows of length {k}", stage="lint")
        row_strs = re.findall(row_pat, body)
        if len(row_strs) != score_val:
            emit(False, f"Score {score_val} does not match row count {len(row_strs)}", stage="lint")
        for rs in row_strs:
            for tok in re.findall(nat, rs):
                if int(tok) >= v:
                    emit(False, f"Entry {tok} exceeds alphabet size {v}", stage="lint")


