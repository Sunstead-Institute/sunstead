    "sort_n16": ("SortNet/Net16.lean", "SortNet.score16", "SortNet.net16"),
}

MAX_BYTES = 16384
MAX_COMPARATORS = 256


def check_network(path, score_name, net_name):
    # Restrict the editable source to concrete comparator literals replayable outside Lean.
    if not path.is_file():
        emit(False, f"Missing network file: {path.name}", stage="lint")
    raw = path.read_bytes()
    if len(raw) > MAX_BYTES:
        emit(False, f"Network file exceeds {MAX_BYTES} bytes", stage="lint")
    try:
        text = raw.decode("utf-8")
    except UnicodeDecodeError:
        emit(False, "Network file must be valid UTF-8", stage="lint")

    nat = r"(?:0|[1-9][0-9]{0,2})"
    pair = rf"\(\s*{nat}\s*,\s*{nat}\s*\)"
    header_re = (
        rf"\s*def\s+{re.escape(score_name)}\s*:\s*Nat\s*:=\s*({nat})\s*\n"
        rf"\s*def\s+{re.escape(net_name)}\s*:\s*List\s*\(Nat\s*×\s*Nat\)\s*:=\s*\[\s*(.*?)\s*\]\s*"
    )
    match = re.fullmatch(header_re, text, re.DOTALL)
    if not match:
        emit(
            False,
            f"Expected only literal definitions for {score_name} and {net_name}",
            stage="lint",
        )
    net_body = match.group(2)
    if not net_body or not re.fullmatch(
        rf"{pair}(?:\s*,\s*{pair}){{0,{MAX_COMPARATORS - 1}}}", net_body
    ):
        emit(
            False,
            f"Expected 1 to {MAX_COMPARATORS} literal (i, j) comparator pairs",
            stage="lint",
        )


if __name__ == "__main__":
    if len(sys.argv) < 2:
        emit(False, "usage: ./verify <task_id>", stage="lint")
    task_id = sys.argv[1]
    if task_id in NET_TARGETS:
        rel_path, score_name, net_name = NET_TARGETS[task_id]
        check_network(
            Path(__file__).resolve().parent / rel_path,
            score_name,
            net_name,
        )
    lean_verify(
        task_id,
        lib_root="SortNet",
        frozen_files=["SortNet/Spec.lean", "UPSTREAM.json", "lakefile.toml", "lean-toolchain"],
        tasks=TASKS,
        uses_mathlib=False,
        timeout_sec=90,
    )
