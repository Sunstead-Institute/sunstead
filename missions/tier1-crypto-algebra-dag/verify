#!/usr/bin/env python3
"""Frozen verifier for `tier1-crypto-algebra-dag`.

All checking logic lives in the trusted harness baked into the verifier image
(/opt/sunstead/sunstead_sandbox.py + SunsteadCheck.lean). This file only lists
each task's module, the theorem that must prove it, and the frozen statement.
Contributor code is built as an unprivileged user; the verdict comes from a
Lean kernel replay of the compiled output, never from text the build printed.
"""
import sys

sys.path.insert(0, "/opt/sunstead")
from sunstead_sandbox import emit, lean_verify  # noqa: E402

LIB_ROOT = 'CryptoAlgebra'
FROZEN_FILES = ['CryptoAlgebra' + "/Spec.lean", "lakefile.toml", "lean-toolchain"]

TASKS = {
    'xor_involution': {
        'module': 'CryptoAlgebra.XorInvolution',
        'theorem': 'CryptoAlgebra.otp_dec_enc',
        'statement': """
def xor_involution : Prop :=
    ∀ {n : Nat} (m k : BitVec n), CryptoAlgebra.otpEnc (CryptoAlgebra.otpEnc m k) k = m
""",
    },
    'xor_bijection': {
        'module': 'CryptoAlgebra.XorBijection',
        'theorem': 'CryptoAlgebra.otp_enc_bijective',
        'statement': """
def xor_bijection : Prop :=
    ∀ {n : Nat} (m : BitVec n), CryptoAlgebra.Bijective (CryptoAlgebra.otpEnc m)
""",
    },
    'otp_perfect_secrecy': {
        'module': 'CryptoAlgebra.OtpPerfectSecrecy',
        'theorem': 'CryptoAlgebra.otp_unique_key',
        'statement': """
def otp_perfect_secrecy : Prop :=
    ∀ {n : Nat} (m c : BitVec n),
    ∃ k : BitVec n, CryptoAlgebra.otpEnc m k = c ∧ ∀ k', CryptoAlgebra.otpEnc m k' = c → k' = k
""",
    },
    'mod_add_laws': {
        'module': 'CryptoAlgebra.ModAddLaws',
        'theorem': 'CryptoAlgebra.modAdd_comm_assoc',
        'statement': """
def mod_add_laws : Prop :=
    ∀ (q a b c : Nat),
    CryptoAlgebra.modAdd q a b = CryptoAlgebra.modAdd q b a ∧
    CryptoAlgebra.modAdd q (CryptoAlgebra.modAdd q a b) c =
    CryptoAlgebra.modAdd q a (CryptoAlgebra.modAdd q b c)
""",
    },
    'mod_mul_dist': {
        'module': 'CryptoAlgebra.ModMulDist',
        'theorem': 'CryptoAlgebra.modMul_comm_assoc_dist',
        'statement': """
def mod_mul_dist : Prop :=
    ∀ (q a b c : Nat),
    CryptoAlgebra.modMul q a b = CryptoAlgebra.modMul q b a ∧
    CryptoAlgebra.modMul q (CryptoAlgebra.modMul q a b) c =
    CryptoAlgebra.modMul q a (CryptoAlgebra.modMul q b c) ∧
    CryptoAlgebra.modMul q a (CryptoAlgebra.modAdd q b c) =
    CryptoAlgebra.modAdd q (CryptoAlgebra.modMul q a b) (CryptoAlgebra.modMul q a c)
""",
    },
    'crt_uniqueness': {
        'module': 'CryptoAlgebra.CrtUniqueness',
        'theorem': 'CryptoAlgebra.crt_unique_mod_mul',
        'statement': """
def crt_uniqueness : Prop :=
    ∀ {m n x y : Nat},
    Nat.gcd m n = 1 → x % m = y % m → x % n = y % n → x % (m * n) = y % (m * n)
""",
    },
    'diffie_hellman_soundness': {
        'module': 'CryptoAlgebra.DiffieHellman',
        'theorem': 'CryptoAlgebra.dh_shared_secret_eq',
        'statement': """
def diffie_hellman_soundness : Prop :=
    ∀ (g a b p : Nat),
    CryptoAlgebra.powMod (CryptoAlgebra.powMod g a p) b p =
    CryptoAlgebra.powMod (CryptoAlgebra.powMod g b p) a p
""",
    },
    'shamir_linear_recovery': {
        'module': 'CryptoAlgebra.ShamirRecovery',
        'theorem': 'CryptoAlgebra.shamir_recover_secret',
        'statement': """
def shamir_linear_recovery : Prop :=
    ∀ {q s a x1 x2 inv_d : Nat},
    s < q → x1 < x2 → ((x2 - x1) * inv_d) % q = 1 % q →
    CryptoAlgebra.lagrangeRecover q x1 (CryptoAlgebra.shamirEval q s a x1) x2 (CryptoAlgebra.shamirEval q s a x2) inv_d = s
""",
    },
}

if __name__ == "__main__":
    if len(sys.argv) < 2:
        emit(False, "usage: ./verify <task_id>")
    lean_verify(sys.argv[1], lib_root=LIB_ROOT, frozen_files=FROZEN_FILES, tasks=TASKS)
