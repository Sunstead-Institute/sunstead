        check_certificate(tid, Path(__file__).resolve().parent)
    lean_verify(
        tid,
        lib_root="RankF2Ext",
        frozen_files=FROZEN_FILES,
        tasks=TASKS,
        uses_mathlib=False,
        timeout_sec=80,
    )
