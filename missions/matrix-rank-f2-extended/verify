def check_certificate(task_id, base_dir):
    spec = CERT_SPECS.get(task_id)
    if spec is None:
        emit(False, f"unknown task id: {task_id}", stage="lint")
    path = base_dir / spec["file"]
    try:
        raw = path.read_bytes()
    except OSError as exc:
        emit(False, f"cannot read certificate: {exc}", stage="lint")
    if len(raw) > 32768:
        emit(False, "Certificate exceeds 32768 bytes", stage="lint")
    try:
        text = raw.decode("utf-8")
    except UnicodeDecodeError:
        emit(False, "Certificate must be valid UTF-8", stage="lint")
    tag = spec["tag"]
    max_r = spec["max_rank"]
    max_a = (1 << (spec["n"] * spec["m"])) - 1
    max_b = (1 << (spec["m"] * spec["p"])) - 1
    max_c = (1 << (spec["p"] * spec["n"])) - 1
    score_line, _, table = text.partition("\n")
    sm = re.fullmatch(rf"def RankF2Ext\.score_{tag} : Nat := ([1-9][0-9]{{0,2}})", score_line)
    if not sm or int(sm[1]) > max_r:
        emit(False, f"Expected literal natural-number score 1..{max_r}", stage="lint")
    body = table.strip()
    mask = r"(0|[1-9][0-9]{0,14})"
    term = rf"\(\s*{mask}\s*,\s*{mask}\s*,\s*{mask}\s*\)"
    header = rf"def RankF2Ext\.cert_{tag} : List \(Nat × Nat × Nat\) :=\s*"
    m = re.fullmatch(header + r"\[\s*(.*?)\s*\]", body, re.DOTALL)
    if not m or not re.fullmatch(rf"{term}(?:\s*,\s*{term}){{0,{max_r - 1}}}", m[1]):
        emit(False, f"Expected literal table of 1 to {max_r} decimal mask triples", stage="lint")
    triples = re.findall(term, m[1])
    if len(triples) != int(sm[1]):
        emit(False, f"Score {sm[1]} does not match table length {len(triples)}", stage="lint")
    for a_s, b_s, c_s in triples:
        if int(a_s) > max_a or int(b_s) > max_b or int(c_s) > max_c:
            emit(False, "Bitmask exceeds matrix dimension width", stage="lint")


