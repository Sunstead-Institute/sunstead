#!/usr/bin/env python3
"""Frozen verifier for `tier2-coding-bounds`.

All checking logic lives in the trusted harness baked into the verifier image
(/opt/sunstead/sunstead_sandbox.py + SunsteadCheck.lean). This file only lists
each task's module, the theorem that must prove it, and the frozen statement.
Contributor code is built as an unprivileged user; the verdict comes from a
Lean kernel replay of the compiled output, never from text the build printed.
"""
import sys

sys.path.insert(0, "/opt/sunstead")
from sunstead_sandbox import emit, lean_verify  # noqa: E402

LIB_ROOT = 'CodingBounds'
FROZEN_FILES = ['CodingBounds' + "/Spec.lean", "lakefile.toml", "lean-toolchain"]

TASKS = {
    'tighten_rs_list_bound': {
        'module': 'CodingBounds.RsListBound',
        'theorem': 'CodingBounds.rs_list_bound',
        'score_const': 'CodingBounds.claimedRsListFactor',
        'label': '100 * rsListLoss(n,k) <= {score} * (n+k)^2',
        'statement': """
def tighten_rs_list_bound (C : Nat) : Prop :=
    ∀ n k : Nat, n ≥ 1 → k ≥ 1 →
    100 * CodingBounds.rsListLoss n k ≤ C * ((n + k) * (n + k))
""",
    },
    'tighten_masking_leakage': {
        'module': 'CodingBounds.MaskingLeakage',
        'theorem': 'CodingBounds.masking_leakage_bound',
        'score_const': 'CodingBounds.claimedMaskingFactor',
        'label': '100 * maskingLeakage(s,g) <= {score} * (s+g)^2',
        'statement': """
def tighten_masking_leakage (C : Nat) : Prop :=
    ∀ s g : Nat, s ≥ 1 → g ≥ 1 →
    100 * CodingBounds.maskingLeakage s g ≤ C * ((s + g) * (s + g))
""",
    },
    'tighten_sponge_birthday': {
        'module': 'CodingBounds.SpongeBirthday',
        'theorem': 'CodingBounds.sponge_birthday_bound',
        'score_const': 'CodingBounds.claimedSpongeFactor',
        'label': '100 * spongeBirthdayLoss(q,b) <= {score} * (q+b)^2',
        'statement': """
def tighten_sponge_birthday (C : Nat) : Prop :=
    ∀ q b : Nat, q ≥ 1 → b ≥ 1 →
    100 * CodingBounds.spongeBirthdayLoss q b ≤ C * ((q + b) * (q + b))
""",
    },
    'tighten_merkle_soundness': {
        'module': 'CodingBounds.MerkleSoundness',
        'theorem': 'CodingBounds.merkle_soundness_bound',
        'score_const': 'CodingBounds.claimedMerkleFactor',
        'label': '100 * merkleSoundnessLoss(h,q) <= {score} * (h+q)^2',
        'statement': """
def tighten_merkle_soundness (C : Nat) : Prop :=
    ∀ h q : Nat, h ≥ 1 → q ≥ 1 →
    100 * CodingBounds.merkleSoundnessLoss h q ≤ C * ((h + q) * (h + q))
""",
    },
}

if __name__ == "__main__":
    if len(sys.argv) < 2:
        emit(False, "usage: ./verify <task_id>")
    lean_verify(sys.argv[1], lib_root=LIB_ROOT, frozen_files=FROZEN_FILES, tasks=TASKS)
