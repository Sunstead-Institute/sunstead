def check_chain(task_id, base_dir):
    spec = CHAIN_SPECS.get(task_id)
    if spec is None:
        emit(False, f"unknown task id: {task_id}", stage="lint")
    path = base_dir / spec["file"]
    if not path.is_file():
        emit(False, f"Missing chain file: {path.name}", stage="lint")
    raw = path.read_bytes()
    if len(raw) > 32768:
        emit(False, "Chain file exceeds 32768 bytes", stage="lint")
    try:
        text = raw.decode("utf-8")
    except UnicodeDecodeError:
        emit(False, "Chain file must be valid UTF-8", stage="lint")
    nat = r"(?:0|[1-9][0-9]{0,3})"
    pair = rf"\(\s*{nat}\s*,\s*{nat}\s*\)"
    header_re = (
        rf"\s*def\s+{re.escape(spec['score_name'])}\s*:\s*Nat\s*:=\s*({nat})\s*\n"
        rf"\s*def\s+{re.escape(spec['steps_name'])}\s*:\s*List\s*\(Nat\s*×\s*Nat\)\s*:=\s*\[\s*(.*?)\s*\]\s*"
    )
    m = re.fullmatch(header_re, text, re.DOTALL)
    if not m:
        emit(False, f"Expected only literal definitions for {spec['score_name']} and {spec['steps_name']}", stage="lint")
    score = int(m.group(1))
    max_s = spec["max_steps"]
    if score < 1 or score > max_s:
        emit(False, f"Score must be in 1..{max_s}", stage="lint")
    body = m.group(2)
    if not body or not re.fullmatch(rf"{pair}(?:\s*,\s*{pair}){{0,{max_s - 1}}}", body):
        emit(False, f"Expected 1 to {max_s} literal (i, j) step pairs", stage="lint")
    pairs = re.findall(pair, body)
    if len(pairs) != score:
        emit(False, f"Score {score} does not match step count {len(pairs)}", stage="lint")


if __name__ == "__main__":
    if len(sys.argv) < 2:
        emit(False, "usage: ./verify <task_id>", stage="lint")
    tid = sys.argv[1]
    if tid in CHAIN_SPECS:
        check_chain(tid, Path(__file__).resolve().parent)
    lean_verify(
        tid,
        lib_root="AddChain",
        frozen_files=FROZEN_FILES,
        tasks=TASKS,
        uses_mathlib=False,
        timeout_sec=50,
    )
