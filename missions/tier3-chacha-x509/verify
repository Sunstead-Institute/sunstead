#!/usr/bin/env python3
"""Frozen verifier for `tier3-chacha-x509`.

Checking logic lives in the trusted harness baked into the verifier image
(/opt/sunstead/sunstead_sandbox.py). The target file is linted (no std/core,
no macros, no calls into spec.rs), then the frozen integration test is built
and run as an unprivileged user in a scratch copy of the repo.
"""
import sys

sys.path.insert(0, "/opt/sunstead")
from sunstead_sandbox import emit, rust_verify  # noqa: E402

TASK_MAP = {
    'ct_eq_32': ('src/ct_eq.rs', 'verify_ct_eq', 'ct_fixed_loop'),
    'ct_cmov_u32': ('src/ct_cmov.rs', 'verify_ct_cmov', 'ct_fixed_loop'),
    'chacha20_quarter_round': ('src/quarter_round.rs', 'verify_quarter_round', 'ct_strict'),
    'chacha20_block': ('src/chacha_block.rs', 'verify_chacha_block', 'ct_fixed_loop'),
    'der_parse_length': ('src/der_length.rs', 'verify_der_length', 'parser_safe'),
    'der_parse_tlv': ('src/der_tlv.rs', 'verify_der_tlv', 'parser_safe'),
    'der_parse_integer': ('src/der_integer.rs', 'verify_der_integer', 'parser_safe'),
    'der_parse_oid': ('src/der_oid.rs', 'verify_der_oid', 'parser_safe'),
}

COMMON_FORBIDDEN = [
    ('\\bunsafe\\b', 'unsafe code is forbidden'),
    ('\\basm!', 'inline assembly is forbidden'),
    ('\\b(?:todo|unimplemented|panic|unreachable)!', 'panicking macros are forbidden'),
    ('\\.unwrap\\s*\\(', '`.unwrap()` is forbidden in panic-free security code'),
    ('\\.expect\\s*\\(', '`.expect()` is forbidden in panic-free security code'),
]

CT_FIXED_LOOP_EXTRA = [
    ('\\bif\\b', 'branching (`if`) is forbidden in constant-time code'),
    ('\\bmatch\\b', 'branching (`match`) is forbidden in constant-time code'),
    ('\\bwhile\\b|\\bloop\\b', 'variable-bound loops (`while`/`loop`) are forbidden in constant-time code'),
    ('\\bbreak\\b|\\bcontinue\\b', 'early-exit control flow (`break`/`continue`) is forbidden in constant-time code'),
    ('(?<!/)%(?!=)', 'modulo operator `%` is variable-time on some CPUs'),
    ('(?<!/)/(?![/*])', 'division operator `/` is variable-time on hardware'),
]

CT_FIXED_LOOP_FORBIDDEN = COMMON_FORBIDDEN + CT_FIXED_LOOP_EXTRA
CT_STRICT_FORBIDDEN = CT_FIXED_LOOP_FORBIDDEN + [
    (r"\bfor\b", "loops are forbidden in quarter_round"),
]

PROFILES = {
    "ct_strict": CT_STRICT_FORBIDDEN,
    "ct_fixed_loop": CT_FIXED_LOOP_FORBIDDEN,
    "parser_safe": COMMON_FORBIDDEN,
}

ALLOWED_MODULES = {'ct_cmov', 'chacha_block', 'der_tlv', 'quarter_round', 'der_oid', 'der_length', 'ct_eq', 'der_integer'}

SUMMARY = "ChaCha20/X.509 `{task_id}` passed security hygiene ({profile}) + RFC/fuzz Rust tests"


if __name__ == "__main__":
    if len(sys.argv) < 2:
        emit(False, "usage: ./verify <task_id>")
    rust_verify(sys.argv[1], tasks=TASK_MAP, profiles=PROFILES,
                allowed_modules=ALLOWED_MODULES, summary_fmt=SUMMARY)
